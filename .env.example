# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/intelligence_ita

# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here        # T2 Oracle (Claude Sonnet 4.6)
DEEPSEEK_API_KEY=your_deepseek_api_key_here          # T3 structured extraction (DeepSeek V3.2)
MISTRAL_API_KEY=your_mistral_api_key_here            # T4b SQL generation (Codestral 2)

# Optional: enable Anthropic prompt caching for Oracle system prompt (~70% input cost reduction)
ANTHROPIC_PROMPT_CACHING=true

# ============================================================
# OpenBB API Keys (Financial Data)
# ============================================================
# FRED API Key (Free - Federal Reserve Economic Data)
# Get yours at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Financial Modeling Prep (Optional - has free tier)
# Get yours at: https://financialmodelingprep.com/developer/docs/
# FMP_API_KEY=your_fmp_api_key_here

# Intrinio (Optional - premium data)
# INTRINIO_API_KEY=your_intrinio_api_key_here

# Polygon (Optional - real-time data)
# POLYGON_API_KEY=your_polygon_api_key_here
# ============================================================

# ============================================================
# Knowledge Base / External Data Sources
# ============================================================
# UCDP Conflict Events API (Free - registration required)
# Register at: https://ucdp.uu.se/apidocs/
# UCDP_API_TOKEN=your_ucdp_token_here

# Backup encryption password (used by deploy/backup-db.sh)
# BACKUP_PASSWORD=your_backup_password_here
# ============================================================

# API Security
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTELLIGENCE_API_KEY=your_api_key_here
# Admin key: bypasses Oracle rate limits (for personal use, sent via X-API-Key header)
# ORACLE_ADMIN_KEY=your_admin_key_here
# Whitelisted IPs: bypass Oracle rate limits (comma-separated, matched against X-Forwarded-For)
# ORACLE_WHITELIST_IPS=1.2.3.4,5.6.7.8

# Application Settings
LOG_LEVEL=INFO
REPORT_OUTPUT_DIR=./reports
DATA_DIR=./data

# Scheduling
DAILY_REPORT_TIME=08:00
TIMEZONE=Europe/Rome

# Daily Pipeline Configuration
PIPELINE_FAIL_FAST=true
PIPELINE_NOTIFY_ON_SUCCESS=true
PIPELINE_NOTIFY_ON_FAILURE=true
PIPELINE_MAX_LOG_DAYS=30

# ============================================================
# Report Email Dispatch (send_report_email.py — step 11)
# ============================================================
# Brevo (ex-Sendinblue) SMTP relay — free tier: 300 email/day
# Setup: brevo.com → Settings → SMTP & API → Generate SMTP key
# Also verify the sender domain via DNS (SPF + DKIM)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email
BREVO_SMTP_PASS=your_brevo_smtp_key
BREVO_FROM_EMAIL=report@intelligence-ita.com
BREVO_FROM_NAME=Intelligence ITA

# Ops alerts. deploy/trigger_pipeline.sh emails this address when the 07:00 UTC cron
# cannot start the pipeline (e.g. expired GITHUB_TOKEN). Without it that failure is
# invisible — no Actions run is created, so nothing shows up on GitHub to notice.
# Falls back to BREVO_FROM_EMAIL when unset.
PIPELINE_ALERT_EMAIL=ops@example.com

# Public URLs for the two report pages (appended with /slug if available)
REPORT_GLOBAL_URL=https://intelligence-ita.com/insights
REPORT_ROMANIA_URL=https://intelligence-ita.com/insights/romania

# Recipients configured in: config/report_recipients.yaml
# ============================================================
