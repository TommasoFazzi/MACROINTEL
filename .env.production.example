# ===================================================================
# INTELLIGENCE ITA — Production Environment Variables
# ===================================================================
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to git.
# ===================================================================

# --- Database ---
POSTGRES_USER=intelligence
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# --- API Keys ---
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key            # T2 Oracle (Claude Sonnet 4.6)
ANTHROPIC_PROMPT_CACHING=true                       # Enable prompt caching for Oracle (reduces rate limit pressure)
DEEPSEEK_API_KEY=your_deepseek_api_key              # T3 structured extraction (DeepSeek V3.2)
MISTRAL_API_KEY=your_mistral_api_key                # T4b SQL generation (Codestral 2)
INTELLIGENCE_API_KEY=CHANGE_ME_RUN_python_-c_"import secrets; print(secrets.token_urlsafe(32))"
ORACLE_ADMIN_KEY=CHANGE_ME_GENERATE_SEPARATE_ADMIN_KEY  # Bypasses Oracle rate limits (X-API-Key header)
ORACLE_WHITELIST_IPS=                                   # Comma-separated IPs that bypass rate limits
FRED_API_KEY=your_fred_api_key

# --- Frontend (build-time) ---
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# --- CORS ---
ALLOWED_ORIGINS=https://yourdomain.com

# --- Pipeline ---
LOG_LEVEL=INFO
PIPELINE_NOTIFY_ON_SUCCESS=true
PIPELINE_NOTIFY_ON_FAILURE=true
PIPELINE_MAX_LOG_DAYS=30

# --- Email (Brevo SMTP relay) ---
# Used by scripts/send_report_email.py for the daily report, and by
# deploy/trigger_pipeline.sh for ops alerts.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email
BREVO_SMTP_PASS=your_brevo_smtp_key
BREVO_FROM_EMAIL=report@yourdomain.com
BREVO_FROM_NAME="Intelligence ITA Report"

# Where ops alerts go when the 07:00 UTC cron cannot start the pipeline.
# Falls back to BREVO_FROM_EMAIL when unset.
PIPELINE_ALERT_EMAIL=ops@example.com

# --- Pipeline trigger ---
# The daily run is fired by `crontab -l` (user deploy) → deploy/trigger_pipeline.sh
# → GitHub workflow_dispatch. Fine-grained PAT on the repo with Actions: Read and
# write. PATs expire — when this one does, no Actions run is created at all and the
# only trace is a 401 in /opt/intelligence-ita/logs/pipeline_trigger.log, so keep
# PIPELINE_ALERT_EMAIL set.
GITHUB_TOKEN=github_pat_CHANGE_ME

# --- Backup ---
BACKUP_PASSWORD=CHANGE_ME_STRONG_ENCRYPTION_PASSWORD
